# Claude API (normalisation)
ANTHROPIC_API_KEY=sk-ant-...

# Microsoft Graph API (Outlook / live.fr) — pour le connecteur outlook
# 1. App Registration sur https://entra.microsoft.com (gratuit)
# 2. "Public client / native (mobile & desktop)" → redirect URI: http://localhost
# 3. API permissions → Microsoft Graph → Mail.Read (déléguées)
MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Le token est mis en cache dans ./token_cache.bin (gitignored) après le premier device flow.

# Google Sheets (sortie) — service account séparé
# Dans Google Cloud Console : créer un service account, télécharger la clé JSON,
# partager le sheet cible avec l'email du service account (Editor).
GOOGLE_SHEETS_SERVICE_ACCOUNT=./sheets-sa.json

# Google Sheet cible (URL ou ID)
TAPAGE_SHEET_ID=1AbCdEfGhIjK...

# Facebook Graph API (events de notre page Le Bidul uniquement)
FB_PAGE_ID=lebidul
FB_PAGE_ACCESS_TOKEN=EAAG...

# Email d'identité (col A "INFO TAPEUR" du sheet)
TAPEUR_EMAIL=lebidul@live.fr
